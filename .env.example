# Public Firebase web configuration. These values identify the Firebase project;
# Firebase Security Rules and Admin SDK token verification enforce access control.
NUXT_PUBLIC_FIREBASE_API_KEY=
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NUXT_PUBLIC_FIREBASE_PROJECT_ID=
NUXT_PUBLIC_FIREBASE_APP_ID=
NUXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NUXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NUXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Server-only service account JSON. Leave unset when the server has Application
# Default Credentials configured. Never commit a real service account key.
NUXT_FIREBASE_SERVICE_ACCOUNT_JSON=
